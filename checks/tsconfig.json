{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "types": [
      "tscircuit",
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "resolveJsonModule": true
  },
  "include": [
    ".",
    "../examples"
  ]
}
