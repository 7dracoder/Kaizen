# Kaizen configuration. Copy to .env (repo root, used by the worker and scripts) and to apps/web/.env.local
# (the web app). Both are gitignored. Everything below except the database is optional; see README "API keys".

# ---- Database: FalkorDB (required) ----
# `npm run db` starts one locally; for hosted FalkorDB use redis://user:password@host:port
FALKORDB_URL=redis://127.0.0.1:6379
# shared memory graph; per-user graphs are kaizen_user_<hash>
FALKORDB_GRAPH=kaizen

# ---- Models (needed to design boards) ----
# Any OpenAI-compatible endpoint, e.g. Nicrron (https://api.nicrron.ai/v1) or OpenRouter (https://openrouter.ai/api/v1).
AI_BASE_URL=https://api.nicrron.ai/v1
AI_API_KEY=
# coder (most calls)
MODEL_CHEAP=openai/gpt-4o-mini
# planner, critic, meta-agent
MODEL_STRONG=anthropic/claude-sonnet-4-6

# ---- Embeddings (optional; without one, memory uses a free local embedder with lower recall) ----
# Through the model gateway (same AI_API_KEY), 1024-dim:
EMBED_MODEL=voyage/voyage-4
# Or Voyage directly (adds reranking):
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-2.5

# ---- Sign-in (optional; without a provider the app runs in anonymous mode) ----
# `npx auth secret` or any random 32+ byte value
AUTH_SECRET=
# https://your-domain in production (stops host-header spoofing of callback links)
AUTH_URL=
# console.cloud.google.com → APIs & Services → Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# resend.com, for email magic links
AUTH_RESEND_KEY=
# e.g. "Kaizen <noreply@yourdomain.com>"
EMAIL_FROM=

# ---- Tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kaizen

# ---- Worker (optional) ----
WORKER_CONCURRENCY=3
